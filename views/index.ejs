<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PlayDex Dashboard</title>
  
  <link rel="icon" type="image/png" href="/logo.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

  <style>
    .game-card {
      transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
      border: none;
      border-radius: 12px;
    }
    .game-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 24px rgba(0,0,0,0.15) !important;
    }
    .card-img-top {
      height: 200px;
      object-fit: cover;
      border-top-left-radius: 12px;
      border-top-right-radius: 12px;
    }
    .badge-genre {
      font-weight: 500;
      padding: 0.4em 0.8em;
      border-radius: 6px;
    }
    .brand-icon { color: #0d6efd; }
    
    /* Style Chatbot AI */
    .style-chat-btn { z-index: 1050; width: 60px; height: 60px; }
    .style-chat-box { z-index: 1050; width: 340px; height: 420px; display: flex; flex-direction: column; }
    .style-chat-history { flex-grow: 1; overflow-y: auto; font-size: 0.9rem; }
  </style>
</head>
<body class="bg-light">

  <!-- NAVBAR -->
  <nav class="navbar navbar-dark bg-dark mb-4 shadow-sm">
    <div class="container d-flex justify-content-between align-items-center">
      <a class="navbar-brand fw-bold d-flex align-items-center" href="#">
        <i class="bi bi-dpad-fill fs-4 me-2 brand-icon"></i>
        PlayDex Dashboard
      </a>
      <div class="d-flex align-items-center gap-2">
        <span id="authStatus" class="badge bg-secondary">Guest</span>
        <!-- Tombol Register -->
        <button id="btnRegister" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#registerModal">
          <i class="bi bi-person-plus me-1"></i> Register
        </button>
        <!-- Tombol Login -->
        <button id="btnLogin" class="btn btn-sm btn-outline-light" data-bs-toggle="modal" data-bs-target="#loginModal">
          <i class="bi bi-box-arrow-in-right me-1"></i> Login
        </button>
        <!-- Tombol Logout -->
        <button id="btnLogout" class="btn btn-sm btn-outline-danger d-none" onclick="handleLogout()">
          <i class="bi bi-box-arrow-right me-1"></i> Logout
        </button>
      </div>
    </div>
  </nav>

  <div class="container">
    <div class="row">
      <!-- FORM INPUT GAME BARU -->
      <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-0 rounded-3">
          <div class="card-header bg-primary text-white rounded-top-3">
            <h5 class="card-title mb-0">
              <i class="bi bi-plus-circle me-2"></i>Tambah Game Baru
            </h5>
          </div>
          <div class="card-body">
            <form id="gameForm" enctype="multipart/form-data">
              <div class="mb-3">
                <label class="form-label text-muted fw-semibold">Judul Game</label>
                <input type="text" name="judul" class="form-control" required>
              </div>
              <div class="mb-3">
                <label class="form-label text-muted fw-semibold">Tahun Rilis</label>
                <input type="number" name="tahun_rilis" class="form-control" placeholder="2024">
              </div>

              <!-- Input Developer -->
              <label class="form-label text-muted fw-semibold">Developer</label>
              <div class="input-group mb-3">
                <select name="developer_id" class="form-select" required>
                  <option value="">-- Pilih Developer --</option>
                  <% developers.forEach(dev => { %>
                    <option value="<%= dev.id %>"><%= dev.nama %></option>
                  <% }) %>
                </select>
                <button type="button" class="btn btn-outline-primary" onclick="tambahDeveloper()">
                  <i class="bi bi-plus-lg"></i>
                </button>
              </div>

              <!-- Input Genre -->
              <label class="form-label text-muted fw-semibold">Genre</label>
              <div class="input-group mb-3">
                <select name="genre_ids" class="form-select" required>
                  <option value="">-- Pilih Genre --</option>
                  <% genres.forEach(g => { %>
                    <option value="<%= g.id %>"><%= g.nama %></option>
                  <% }) %>
                </select>
                <button type="button" class="btn btn-outline-primary" onclick="tambahGenre()">
                  <i class="bi bi-plus-lg"></i>
                </button>
              </div>

              <div class="mb-3">
                <label class="form-label text-muted fw-semibold">Deskripsi</label>
                <textarea name="deskripsi" class="form-control" rows="3"></textarea>
              </div>
              <div class="mb-3">
                <label class="form-label text-muted fw-semibold">Cover Game</label>
                <input type="file" name="gambar" class="form-control" accept="image/*">
              </div>
              <button type="submit" class="btn btn-primary w-100 fw-bold">
                <i class="bi bi-save me-1"></i> Simpan Game
              </button>
            </form>
          </div>
        </div>
      </div>

      <!-- LISTING GAME -->
      <div class="col-md-8">
        <h4 class="mb-3 fw-bold text-dark">
          <i class="bi bi-collection me-2"></i>Daftar Game
        </h4>
        <div class="row">
          <% if (games.length === 0) { %>
            <div class="col-12">
              <div class="alert alert-warning border-0 shadow-sm text-center py-4">
                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                Belum ada data game yang ditambahkan.
              </div>
            </div>
          <% } %>

          <% games.forEach(game => { %>
            <div class="col-md-6 mb-4">
              <div class="card h-100 shadow-sm game-card d-flex flex-column">
                <img src="<%= game.gambar || 'https://via.placeholder.com/600x400?text=No+Image' %>" class="card-img-top" alt="<%= game.judul %>">
                <div class="card-body d-flex flex-column">
                  <h5 class="card-title fw-bold mb-1"><%= game.judul %></h5>
                  
                  <p class="text-muted mb-2 small d-flex align-items-center">
                    <i class="bi bi-buildings me-2 text-secondary"></i>
                    <%= game.developer ? game.developer.nama : 'Unknown' %> 
                    <span class="ms-1">(<%= game.tahun_rilis || '-' %>)</span>
                  </p>
                  
                  <div class="mb-3">
                    <% if (game.genres && game.genres.length > 0) { %>
                      <% game.genres.forEach(g => { %>
                        <span class="badge bg-info text-dark badge-genre me-1"><%= g.nama %></span>
                      <% }) %>
                    <% } %>
                  </div>
                  
                  <p class="card-text text-secondary mb-3" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                    <%= game.deskripsi %>
                  </p>

                  <!-- Tombol Aksi: Edit & Hapus -->
                  <div class="mt-auto pt-3 border-top d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-sm btn-outline-warning" 
                      data-id="<%= game.id %>"
                      data-judul="<%= game.judul %>"
                      data-tahun="<%= game.tahun_rilis || 0 %>"
                      data-deskripsi="<%= game.deskripsi %>"
                      onclick="bukaModalEditFromElem(this)">
                      <i class="bi bi-pencil"></i> Edit
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="hapusGame(<%= game.id %>)">
                      <i class="bi bi-trash"></i> Hapus
                    </button>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <!-- FLOATING BUTTON CHATBOT AI -->
  <button id="chatToggleBtn" class="btn btn-primary rounded-circle shadow-lg position-fixed bottom-0 end-0 m-4 p-3 style-chat-btn" onclick="toggleChatBox()">
    <i class="bi bi-chat-dots-fill fs-3"></i>
  </button>

  <!-- WIDGET CHATBOT AI -->
  <div id="chatBox" class="card shadow-lg position-fixed bottom-0 end-0 m-4 d-none style-chat-box">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
      <h6 class="mb-0"><i class="bi bi-robot me-2"></i>PlayDex AI Assistant</h6>
      <div class="d-flex align-items-center gap-1">
        <!-- Tombol Clear Chat -->
        <button type="button" class="btn btn-sm btn-link text-white p-0 me-2" onclick="clearChat()" title="Hapus Riwayat Chat">
          <i class="bi bi-trash"></i>
        </button>
        <button type="button" class="btn-close btn-close-white" onclick="toggleChatBox()"></button>
      </div>
    </div>
    <div id="chatHistory" class="card-body p-3 style-chat-history">
      <!-- Pesan Chat AI akan muncul di sini -->
    </div>
    <div class="card-footer p-2 bg-light border-0">
      <form id="chatForm" class="d-flex gap-2 m-0">
        <input type="text" id="chatInput" class="form-control form-control-sm" placeholder="Tanyakan sesuatu..." required>
        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-send-fill"></i></button>
      </form>
    </div>
  </div>

  <!-- MODAL EDIT GAME -->
  <div class="modal fade" id="editGameModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 rounded-3 shadow">
        <div class="modal-header bg-warning border-0 py-3">
          <h5 class="modal-title fw-semibold d-flex align-items-center text-dark">
            <i class="bi bi-pencil-square fs-5 me-2"></i>Edit Game
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <form id="editGameForm" enctype="multipart/form-data">
            <input type="hidden" id="editGameId">
            <div class="mb-3">
              <label class="form-label text-secondary fw-semibold">Judul Game</label>
              <input type="text" id="editJudul" name="judul" class="form-control" required>
            </div>
            <div class="mb-3">
              <label class="form-label text-secondary fw-semibold">Tahun Rilis</label>
              <input type="number" id="editTahun" name="tahun_rilis" class="form-control">
            </div>
            <div class="mb-3">
              <label class="form-label text-secondary fw-semibold">Deskripsi</label>
              <textarea id="editDeskripsi" name="deskripsi" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label text-secondary fw-semibold">Ganti Cover (Opsional)</label>
              <input type="file" name="gambar" class="form-control" accept="image/*">
            </div>
            <button type="submit" class="btn btn-warning w-100 fw-bold py-2 mt-2">
              Update Game
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL REGISTER -->
  <div class="modal fade" id="registerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 rounded-3 shadow">
        <div class="modal-header bg-info text-dark border-0 py-3">
          <h5 class="modal-title fw-semibold d-flex align-items-center">
            <i class="bi bi-person-plus fs-5 me-2"></i>Register Akun
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <form id="registerForm">
            <div class="mb-3">
              <label class="form-label text-secondary fw-normal">Username / Email</label>
              <input type="text" id="regUsername" class="form-control" required>
            </div>
            <div class="mb-4">
              <label class="form-label text-secondary fw-normal">Password</label>
              <input type="password" id="regPassword" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-info text-dark w-100 fw-bold py-2 fs-6">
              Daftar Akun
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL LOGIN -->
  <div class="modal fade" id="loginModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 rounded-3 shadow">
        <div class="modal-header bg-dark text-white border-0 py-3">
          <h5 class="modal-title fw-semibold d-flex align-items-center">
            <i class="bi bi-lock fs-5 me-2"></i>Login Admin
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <form id="loginForm">
            <div class="mb-3">
              <label class="form-label text-secondary fw-normal">Username / Email</label>
              <input type="text" id="loginUsername" class="form-control" required>
            </div>
            <div class="mb-4">
              <label class="form-label text-secondary fw-normal">Password</label>
              <input type="password" id="loginPassword" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-primary w-100 fw-bold py-2 fs-6">
              Masuk
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
    // --- UTILS: JWT & UI ---
    function getAuthHeaders() {
      const token = localStorage.getItem('api_token');
      return token ? { 'Authorization': `Bearer ${token}` } : {};
    }

    function updateAuthUI() {
      const token = localStorage.getItem('api_token');
      const statusBadge = document.getElementById('authStatus');
      const btnRegister = document.getElementById('btnRegister');
      const btnLogin = document.getElementById('btnLogin');
      const btnLogout = document.getElementById('btnLogout');

      if (token) {
        statusBadge.className = 'badge bg-success';
        statusBadge.textContent = 'Authenticated (JWT)';
        btnRegister.classList.add('d-none');
        btnLogin.classList.add('d-none');
        btnLogout.classList.remove('d-none');
      } else {
        statusBadge.className = 'badge bg-secondary';
        statusBadge.textContent = 'Guest';
        btnRegister.classList.remove('d-none');
        btnLogin.classList.remove('d-none');
        btnLogout.classList.add('d-none');
      }
    }

    // --- AUTHENTICATION: REGISTER ---
    document.getElementById('registerForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const username = document.getElementById('regUsername').value;
      const password = document.getElementById('regPassword').value;

      try {
        const res = await fetch('/api/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });
        const data = await res.json();

        if (res.ok) {
          alert('Registrasi berhasil! Silakan login.');
          bootstrap.Modal.getInstance(document.getElementById('registerModal')).hide();
          new bootstrap.Modal(document.getElementById('loginModal')).show();
        } else {
          alert('Registrasi gagal: ' + (data.message || 'Error'));
        }
      } catch (err) {
        alert('Server Error.');
      }
    });

    // --- AUTHENTICATION: LOGIN ---
    document.getElementById('loginForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const username = document.getElementById('loginUsername').value;
      const password = document.getElementById('loginPassword').value;

      try {
        const res = await fetch('/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });
        const data = await res.json();

        if (res.ok) {
          localStorage.setItem('api_token', data.token);
          alert('Login Berhasil!');
          location.reload(); 
        } else {
          alert('Login gagal: ' + (data.message || 'Kredensial tidak valid'));
        }
      } catch (err) {
        alert('Server Error.');
      }
    });

    // --- AUTHENTICATION: LOGOUT ---
    function handleLogout() {
      localStorage.removeItem('api_token');
      alert('Berhasil Logout');
      location.reload();
    }

    // --- API PROTECTED ACTIONS (JWT REQUIRED) ---

    // 1. Tambah Game
    document.getElementById('gameForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      if (!localStorage.getItem('api_token')) {
        return alert('Silakan Login terlebih dahulu untuk menyimpan game!');
      }

      const formData = new FormData(this);
      try {
        const res = await fetch('/api/games', {
          method: 'POST',
          headers: getAuthHeaders(),
          body: formData 
        });

        if (res.ok) location.reload();
        else {
          const err = await res.json();
          alert('Gagal simpan: ' + (err.message || 'Unauthorized'));
        }
      } catch (error) {
        alert('Server Error.');
      }
    });

    // 2. Tambah Developer
    async function tambahDeveloper() {
      if (!localStorage.getItem('api_token')) return alert('Silakan Login dahulu!');

      const nama = prompt('Masukkan Nama Developer Baru:');
      if (nama && nama.trim() !== '') {
        try {
          const res = await fetch('/api/developers', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', ...getAuthHeaders() },
            body: JSON.stringify({ nama, negara: 'Unknown' })
          });
          if (res.ok) location.reload();
          else alert('Gagal tambah developer! Cek JWT token Anda.');
        } catch (error) {
          alert('Server Error.');
        }
      }
    }

    // 3. Tambah Genre
    async function tambahGenre() {
      if (!localStorage.getItem('api_token')) return alert('Silakan Login dahulu!');

      const nama = prompt('Masukkan Nama Genre Baru:');
      if (nama && nama.trim() !== '') {
        try {
          const res = await fetch('/api/genres', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', ...getAuthHeaders() },
            body: JSON.stringify({ nama })
          });
          if (res.ok) location.reload();
          else alert('Gagal tambah genre! Cek JWT token Anda.');
        } catch (error) {
          alert('Server Error.');
        }
      }
    }

    // 4. Hapus Game
    async function hapusGame(id) {
      if (!localStorage.getItem('api_token')) return alert('Silakan Login dahulu!');

      if (confirm('Yakin ingin menghapus game ini?')) {
        try {
          const res = await fetch(`/api/games/${id}`, { 
            method: 'DELETE',
            headers: getAuthHeaders()
          });
          if (res.ok) location.reload();
          else alert('Gagal menghapus game! Cek JWT token Anda.');
        } catch (error) {
          alert('Server Error.');
        }
      }
    }

    // 5. Buka Modal Edit & Submit Update Game
    function bukaModalEditFromElem(btnElem) {
      if (!localStorage.getItem('api_token')) return alert('Silakan Login dahulu!');
      
      document.getElementById('editGameId').value = btnElem.getAttribute('data-id');
      document.getElementById('editJudul').value = btnElem.getAttribute('data-judul');
      document.getElementById('editTahun').value = btnElem.getAttribute('data-tahun');
      document.getElementById('editDeskripsi').value = btnElem.getAttribute('data-deskripsi');
      
      new bootstrap.Modal(document.getElementById('editGameModal')).show();
    }

    document.getElementById('editGameForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const id = document.getElementById('editGameId').value;
      const formData = new FormData(this);

      try {
        const res = await fetch(`/api/games/${id}`, {
          method: 'PUT',
          headers: getAuthHeaders(),
          body: formData
        });

        if (res.ok) location.reload();
        else alert('Gagal memperbarui game.');
      } catch (err) {
        alert('Server error.');
      }
    });

    // --- FITUR AI CHATBOT (/api/chat & /api/chat/history) ---
    let isChatClearedLocally = false;

    function toggleChatBox() {
      const box = document.getElementById('chatBox');
      box.classList.toggle('d-none');
      if (!box.classList.contains('d-none')) {
        loadChatHistory();
      }
    }

    async function loadChatHistory() {
      const container = document.getElementById('chatHistory');

      // Jika user sudah menekan clear chat di sesi ini, jangan reload riwayat dari server
      if (isChatClearedLocally) {
        if (container.children.length === 0) {
          container.innerHTML = '<p class="text-muted text-center mt-3 small">Riwayat chat telah dibersihkan.</p>';
        }
        return;
      }

      if (!localStorage.getItem('api_token')) {
        container.innerHTML = '<p class="text-muted text-center mt-3 small">Silakan Login untuk menggunakan AI Assistant.</p>';
        return;
      }

      try {
        const res = await fetch('/api/chat/history', { headers: getAuthHeaders() });
        if (res.ok) {
          const result = await res.json();
          const history = Array.isArray(result) ? result : (result.data || []);
          
          if (history.length === 0) {
            container.innerHTML = '<p class="text-muted text-center mt-3 small">Belum ada riwayat obrolan.</p>';
            return;
          }

          container.innerHTML = history.map(c => `
            <div class="mb-2 d-flex justify-content-end">
              <span class="badge bg-primary text-wrap text-start rounded-pill px-3 py-2 lh-base" style="max-width: 85%; font-weight: normal;">
                ${c.pesan_user || c.message || ''}
              </span>
            </div>
            <div class="mb-2 d-flex justify-content-start">
              <span class="badge bg-secondary text-wrap text-start rounded-pill px-3 py-2 lh-base" style="max-width: 85%; font-weight: normal;">
                ${c.balasan_ai || c.response || ''}
              </span>
            </div>
          `).join('');
          container.scrollTop = container.scrollHeight;
        }
      } catch (err) {
        console.error(err);
      }
    }

    async function clearChat() {
      if (!confirm('Apakah Anda yakin ingin menghapus riwayat chat?')) return;

      const container = document.getElementById('chatHistory');
      container.innerHTML = '<p class="text-muted text-center mt-3 small">Riwayat chat telah dibersihkan.</p>';

      // Set flag lokal agar penutupan & pembukaan kembali modal tidak re-fetch history
      isChatClearedLocally = true;

      if (localStorage.getItem('api_token')) {
        try {
          await fetch('/api/chat/history', {
            method: 'DELETE',
            headers: getAuthHeaders()
          });
        } catch (err) {
          console.error('Gagal menghapus riwayat di backend:', err);
        }
      }
    }

    document.getElementById('chatForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      if (!localStorage.getItem('api_token')) return alert('Silakan Login dahulu untuk menggunakan Chatbot!');

      const input = document.getElementById('chatInput');
      const message = input.value;
      input.value = '';

      const container = document.getElementById('chatHistory');
      
      // Reset tampilan jika sebelumnya di-clear
      if (isChatClearedLocally) {
        container.innerHTML = '';
        isChatClearedLocally = false;
      }

      container.innerHTML += `
        <div class="mb-2 d-flex justify-content-end">
          <span class="badge bg-primary text-wrap text-start rounded-4 px-3 py-2 lh-base" style="max-width: 85%; font-weight: normal;">${message}</span>
        </div>`;
      container.scrollTop = container.scrollHeight;

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', ...getAuthHeaders() },
          body: JSON.stringify({ pesan_user: message })
        });
        const data = await res.json();
        
        if (res.ok) {
          const balasan = data.data ? data.data.balasan_ai : (data.balasan_ai || data.response);
          
          container.innerHTML += `
            <div class="mb-2 d-flex justify-content-start">
              <span class="badge bg-secondary text-wrap text-start rounded-4 px-3 py-2 lh-base" style="max-width: 85%; font-weight: normal;">${balasan}</span>
            </div>`;
          container.scrollTop = container.scrollHeight;
        } else {
          console.error("Gagal mendapat respon AI:", data);
        }
      } catch (err) {
        alert('Gagal mengirim pesan ke AI.');
      }
    });

    // Inisialisasi status Auth saat pertama kali dimuat
    updateAuthUI();
  </script>
</body>
</html>